{
  "name": "ytci-tanstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --env-file=.env.local run vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "db:smoke": "bun --env-file=.env.local run scripts/db-smoke.ts",
    "db:generate": "better-auth generate -y --output ./src/db/schema/auth.ts && drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:setup": "bun run db:generate && bun run db:migrate && bun run db:smoke",
    "bootstrap:admin": "bun --env-file=.env.local run scripts/bootstrap-admin.ts",
    "seed:test-users": "bun --env-file=.env.local run scripts/seed-test-users.ts",
    "seed:go-data": "bun --env-file=.env.local run scripts/seed-go-test-data.ts",
    "test:e2e": "bunx playwright test e2e/auth.spec.ts e2e/user-management.spec.ts e2e/crud-ui.spec.ts",
    "test:e2e:integration": "INTEGRATION_TEST=true bunx playwright test e2e/crud-integration.spec.ts",
    "test:e2e:all": "bunx playwright test e2e/auth.spec.ts e2e/user-management.spec.ts e2e/crud-ui.spec.ts e2e/crud-integration.spec.ts",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@faker-js/faker": "^10.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/intent": "^0.3.6",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}