# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=CHANGE_ME

# Database (local dev — Postgres on bare metal; pg_hba is `trust` so the
# password is accepted but ignored by the server in dev; production rotates
# it and switches pg_hba off trust).
DATABASE_URL=postgres://ytci:CHANGE_ME@localhost:5432/ytci