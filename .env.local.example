# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=CHANGE_ME

# Database (local dev — Postgres 17 with PostGIS; pg_hba is `trust` so the
# password is accepted but ignored by the server in dev; production rotates
# it and switches pg_hba off trust).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/ytci
# --- Execution shell (#360) -------------------------------------------------
# Frozen contracts API. Dev default is the mock on :8099; set this to the
# Go API or the BFF proxy in deployed environments.
VITE_CONTRACTS_API_URL=
# Surface flags — every new surface ships off. Set to "true" to launch.
VITE_FLAG_MICE=false
VITE_FLAG_RECOGNITION=false
VITE_FLAG_SPECIES=false
VITE_FLAG_ANALYTICS=false
